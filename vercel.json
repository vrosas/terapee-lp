{
  "redirects": [
    {
      "source": "/terapee-vs-psicoplanner",
      "destination": "/alternativas/psicoplanner",
      "permanent": true
    },
    {
      "source": "/ferramentas",
      "destination": "/ferramentas/calculadora-de-precificacao",
      "permanent": false
    },
    {
      "source": "/ferramentas/",
      "destination": "/ferramentas/calculadora-de-precificacao",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
