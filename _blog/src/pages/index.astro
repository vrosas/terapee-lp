---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogListing from '../components/BlogListing.astro';
import { getPublishedPosts, postPath } from '../lib/posts';

const posts = await getPublishedPosts();
const site = 'https://www.terapee.com.br';
const title = 'Blog da Terapee: gestão de clínicas de terapia';
const description = 'Conteúdo prático para psicólogos, fonoaudiólogos, terapeutas ocupacionais e clínicas multidisciplinares: gestão, financeiro, agenda, prontuário e teleconsulta.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog da Terapee',
    url: `${site}/blog/`,
    description,
    inLanguage: 'pt-BR',
    publisher: { '@type': 'Organization', name: 'Terapee', url: `${site}/`, logo: { '@type': 'ImageObject', url: `${site}/logo-terapee.png` } },
    blogPost: posts.slice(0, 20).map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: site + postPath(p), datePublished: p.data.publishedAt.toISOString() })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} path="/blog/" jsonLd={jsonLd} noindex={posts.filter((p) => !p.data.draft).length === 0}>
  <BlogListing
    posts={posts}
    badge="Blog"
    heading='Gestão de clínicas de terapia, <span class="highlight">sem enrolação</span>'
    lead="Conteúdo prático para quem atende e administra: agenda, financeiro, prontuário, teleconsulta e a rotina de uma clínica multidisciplinar."
    breadcrumb={[{ name: 'Início', href: '/' }, { name: 'Blog' }]}
  />
</BaseLayout>
