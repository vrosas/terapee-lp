{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/terapee-vs-psicoplanner",
      "destination": "/alternativas/psicoplanner",
      "permanent": true
    },
    {
      "source": "/ferramentas",
      "destination": "/ferramentas/calculadora-de-precificacao",
      "permanent": false
    },
    {
      "source": "/ferramentas/",
      "destination": "/ferramentas/calculadora-de-precificacao",
      "permanent": false
    },
    {
      "source": "/blog/category/:slug",
      "destination": "/blog/categoria/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/blog/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
