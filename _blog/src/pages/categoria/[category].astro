---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListing from '../../components/BlogListing.astro';
import { CATEGORIES } from '../../data/categories';
import { getPublishedPosts } from '../../lib/posts';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const posts = (await getPublishedPosts()).filter((p) => p.data.category === category.slug);
const site = 'https://www.terapee.com.br';
const path = `/blog/categoria/${category.slug}/`;

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
    { '@type': 'ListItem', position: 3, name: category.name, item: site + path },
  ],
}];
---
<BaseLayout
  title={`${category.name} | Blog da Terapee`}
  description={category.description}
  path={path}
  jsonLd={jsonLd}
  noindex={posts.length === 0}
>
  <BlogListing
    posts={posts}
    badge="Categoria"
    heading={category.name}
    lead={category.description}
    activeCategory={category.slug}
    breadcrumb={[{ name: 'Início', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: category.name }]}
  />
</BaseLayout>
